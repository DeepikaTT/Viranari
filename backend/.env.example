VIRANARI_DB_PATH=./data/viranari.db
# Production: set your own 64+ character random secret.
# If omitted in development, ViraNari creates ./data/.jwt_secret with mode 0600.
VIRANARI_JWT_SECRET=
VIRANARI_ACCESS_TOKEN_MINUTES=720
VIRANARI_INVITE_MINUTES=1440
VIRANARI_CORS_ORIGINS=*
VIRANARI_HOST=0.0.0.0
VIRANARI_PORT=3000
